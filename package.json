{
  "name": "dsh-tavern-renderer",
  "version": "0.2.1",
  "description": "Self-contained SillyTavern-style safe message renderer for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./core": "./src/core/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "src/core",
    "README.md",
    "SPEC.md",
    "DESIGN.md",
    "SOURCES.md",
    "QUALITY-REVIEW.md",
    "demo/documents-message.txt",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "test": "vitest run",
    "test:host": "node --test tests/host-contract.test.mjs",
    "test:watch": "vitest",
    "check": "npm run test && npm run build && npm run test:host",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1 <0.1.3-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1 <0.1.3-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.1.3-0",
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-rc.1 <0.1.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiweiDonVee/dsh-tavern-renderer.git"
  },
  "homepage": "https://github.com/LiweiDonVee/dsh-tavern-renderer",
  "bugs": {
    "url": "https://github.com/LiweiDonVee/dsh-tavern-renderer/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "roleplay"
  ]
}
